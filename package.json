{
  "name": "signals",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable bullish/bearish/neutral signal dashboard for stocks & crypto, built on free data sources and TypeSafe/Jev.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "pipeline": "node --env-file-if-exists=.env scripts/run-pipeline.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.7.0",
    "openai": "^7.18.0",
    "zod": "^4.6.5"
  }
}
