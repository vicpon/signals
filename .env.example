# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

# Required: TypeSafe API key for Jev calls (https://docs.typesafe.ai).
TYPESAFE_API_KEY=

# Optional: SEC EDGAR requires a descriptive User-Agent identifying the
# requester (their fair-access policy, not a secret). Set this to your own
# contact info before running the pipeline against SEC endpoints.
SEC_USER_AGENT=signals-dashboard/0.1 (contact: you@example.com)

# Optional: port for the dashboard server.
PORT=3000

# Optional: enables the Reddit source (r/stocks or r/CryptoCurrency search).
# Reddit's read-only search is no longer usable anonymously, but a free
# "script" app still works with no user password needed — register one at
# https://www.reddit.com/prefs/apps and put its client id/secret here. If
# left blank, the pipeline just skips Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signals-dashboard/0.1 (set REDDIT_USER_AGENT in .env)
