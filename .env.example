# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

# Required: TypeSafe API key for Jev calls (https://docs.typesafe.ai).
TYPESAFE_API_KEY=

# Optional: SEC EDGAR requires a descriptive User-Agent identifying the
# requester (their fair-access policy, not a secret). Set this to your own
# contact info before running the pipeline against SEC endpoints.
SEC_USER_AGENT=signals-dashboard/0.1 (contact: you@example.com)

# Optional: port for the dashboard server.
PORT=3000

# Optional: pipeline pacing, in milliseconds — all three fall back to the
# defaults shown if unset or invalid. REQUEST_SPACING_MS is the pause between
# tickers (each ticker bursts up to 8 articles × 2 judge calls); the two
# CROWD_* values pace the one-time TradingView symbol lookups and CoinGecko
# vote fetches before the ticker loop starts.
REQUEST_SPACING_MS=30000
CROWD_SEARCH_SPACING_MS=1000
CROWD_COIN_SPACING_MS=10000

# Optional: enables the Reddit source (r/stocks or r/CryptoCurrency search).
# Reddit's read-only search is no longer usable anonymously, but a free
# "script" app still works with no user password needed — register one at
# https://www.reddit.com/prefs/apps and put its client id/secret here. If
# left blank, the pipeline just skips Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signals-dashboard/0.1 (set REDDIT_USER_AGENT in .env)

# Optional: enables the OpenAI comparison engine, judging the exact same
# articles as Jev for a side-by-side comparison. Unlike everything else in
# this project, OpenAI is a PAID API — this is opt-in and skipped entirely
# if left blank. Defaults to OpenAI's flagship model (strongest available,
# not their cheap/fast tier) since the point is Jev (cheap+fast) vs.
# OpenAI's best general model, not a same-tier matchup. Model naming moves
# fast; check OpenAI's current docs — the default below may be outdated by
# the time you read this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
